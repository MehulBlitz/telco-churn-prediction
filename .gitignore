# .gitignore — common for all three projects

# Data (download via download_data.py or Kaggle; never commit datasets)
data/
*.csv
*.zip

# Trained models and metrics can be regenerated by running training
artifacts/*.joblib

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log
training_log.txt
